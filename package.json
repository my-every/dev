    "embla-carousel-react": "8.6.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "input-otp": "1.4.2",
    "jotai": "^2.19.1",
    "jszip": "^3.10.1",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "occt-import-js": "^0.0.23",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.5",
    "react-hook-form": "^7.75.0",
    "react-markdown": "^10.1.0",
    "react-remove-scroll": "^2.7.2",
    "react-resizable-panels": "^4.10.0",
    "react-to-print": "^3.3.0",
    "recharts": "3.8.1",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "swapy": "^1.0.5",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "tunnel-rat": "^0.1.2",
    "uuid": "^14.0.0",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/oxide": "4.2.4",
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.4",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "19.2.14",
