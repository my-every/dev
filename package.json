{
  "name": "d380",
  "version": "0.1.0",
  "description": "Local-first D380 operations desktop and web workspace.",
  "author": "Billy Truong - Solar Turbines",
  "private": true,
  "main": "dist-electron/electron/main/main.js",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:next": "next dev -p 3000",
    "dev:electron": "wait-on tcp:3000 file:dist-electron/electron/main/main.js && electron ./dist-electron/electron/main/main.js",
    "dev:desktop": "concurrently -k \"pnpm dev:next\" \"pnpm watch:electron\" \"pnpm dev:electron\"",
    "build": "next build",
    "build:web": "next build",
    "build:web:prepare-desktop": "pnpm build:web && node scripts/materialize-standalone-symlinks.js",
    "build:electron": "tsc -p electron/tsconfig.json",
    "watch:electron": "tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
    "build:desktop": "pnpm build:web:prepare-desktop && pnpm build:electron",
    "dist:win": "pnpm build:desktop && electron-builder --config electron-builder.yml --win nsis",
    "dist:mac": "pnpm build:desktop && electron-builder --config electron-builder.yml --mac dmg zip",
    "dist:mac:arm64": "pnpm build:desktop && electron-builder --config electron-builder.yml --mac dmg zip --arm64",
    "dist:mac:x64": "pnpm build:desktop && electron-builder --config electron-builder.yml --mac dmg zip --x64",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "dedupe:csv": "node --experimental-strip-types scripts/remove-duplicate-rows.ts",
    "merge:csv-folder": "node --experimental-strip-types scripts/merge-csv-folder.ts",
    "copy:legals": "node --experimental-strip-types scripts/copy-latest-legal-drawings.ts",
    "seed:mock": "node --experimental-strip-types scripts/seed-mock-workspace.ts",
    "seed:slots-projects": "node --experimental-strip-types scripts/seed-slot-project-manifests.ts",
    "seed:badge-dashboard": "node --experimental-strip-types scripts/seed-badge-dashboard-showcase.ts",
    "brandlist:auto-merge": "node --no-warnings --experimental-strip-types scripts/auto-merge-brandlist.ts --brandlist-dir \"Share/Brand List\" --decision-policy sync-all",
    "brandlist:sync-legals": "node --no-warnings --experimental-strip-types scripts/auto-merge-brandlist.ts --brandlist-dir \"Share/Brand List\" --decision-policy sync-all --legal-drawings-only",
    "activity:backfill-project-indexes": "node --experimental-strip-types scripts/backfill-activity-project-indexes.ts",
    "legal:backfill": "node scripts/backfill-legal-drawings-library.mjs",
    "legal:enrich-metadata": "node scripts/enrich-legal-drawings-metadata.mjs",
    "legal:clear-meta": "node --no-warnings --experimental-strip-types scripts/legal-drawings-maintenance.ts clear-meta",
    "legal:clear-generated": "node --no-warnings --experimental-strip-types scripts/legal-drawings-maintenance.ts clear-generated",
    "legal:clear-revision-meta": "node --no-warnings --experimental-strip-types scripts/legal-drawings-maintenance.ts clear-revision-meta",
    "legal:clear-unknown-schema-compare": "node --no-warnings --experimental-strip-types scripts/legal-drawings-maintenance.ts clear-unknown-schema-compare",
    "legal:clear-empty-directories": "node --no-warnings --experimental-strip-types scripts/legal-drawings-maintenance.ts clear-empty-directories",
    "legal:clear-orphans": "node --no-warnings --experimental-strip-types scripts/legal-drawings-maintenance.ts clear-orphans",
    "legal:restore-root-sources": "node --no-warnings --experimental-strip-types scripts/legal-drawings-maintenance.ts restore-root-sources",
    "legal:rebuild-layout-references": "node scripts/rebuild-layout-references-from-legals.mjs",
    "legal:rebuild-unit-box-reference": "node scripts/rebuild-layout-references-from-legals.mjs",
    "legal:rebuild-layout-references:scoped": "node scripts/rebuild-layout-references-from-legals.mjs",
    "legal:group-assignments-by-box": "node scripts/group-assignments-by-unit-type-from-box-number.mjs",
    "legal:group-assignments-by-box:export": "node scripts/group-assignments-by-unit-type-from-box-number.mjs --out-json Share/References/assignments-by-unit-via-box.json --out-csv Share/References/assignments-by-unit-via-box.csv",
    "reference:backfill-mappings": "node scripts/backfill-mappings-from-unit-box-reference.mjs",
    "reference:backfill-mappings:dry": "node scripts/backfill-mappings-from-unit-box-reference.mjs --dry-run",
    "reference:sync-branding-lengths": "node scripts/sync-branding-label-reference.mjs",
    "sws:generate-assignment-tasks": "tsx scripts/generate-sws-assignment-tasks.ts",
    "reference:sync-branding-lengths:scoped": "node scripts/sync-branding-label-reference.mjs",
    "reference:compare-wire-brand-lengths": "node scripts/export-wire-brand-length-comparison.mjs",
    "legal:extract-panel-dimensions": "node scripts/extract-panel-dimensions-from-layouts.mjs",
    "legal:reset": "node --no-warnings --experimental-strip-types scripts/legal-drawings-maintenance.ts reset-all",
    "legal:help": "node --no-warnings --experimental-strip-types scripts/legal-drawings-maintenance.ts help"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
